# 로컬에서는 비워 둬도 돌아가요(기록은 .data/db.json). Vercel에 올릴 때는 셋 다 필요해요.
# 쿠키 서명과 API 키 암호화에 쓰는 긴 임의 글자(바꾸면 저장된 API 키를 다시 넣어야 해요)
SESSION_SECRET=
# 교사 비밀번호(비우면 1324)
TEACHER_PASSWORD=
# Firebase 서비스 계정 JSON 전체를 한 줄로
# MongoDB Atlas 연결 주소(있으면 Firestore보다 먼저 씀)
MONGODB_URI=
FIREBASE_SERVICE_ACCOUNT=

# 휴대폰 알림(웹 푸시) 키: node -e "console.log(require(\"web-push\").generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 모음 이름 앞(배포 maeumbit_, 연습용 컴퓨터는 maeumbit_dev_)
DATA_PREFIX=

# 공용 업스테이지 키(선택). 체험(/try)은 이 키로 업스테이지만 쓰고(하루 200번),
# 실제 학급은 「설정」에 그 AI 키가 없을 때 학급마다 하루 SHARED_AI_PER_DAY번(비우면 100, 0이면 끔)까지 빌려 쓴다.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=
SHARED_AI_PER_DAY=

# 심사용 체험 전용 AI 키(선택). UPSTAGE_API_KEY가 없을 때만 체험이 이 키를 쓴다(하루 200번).
TRIAL_AI_PROVIDER=upstage
TRIAL_AI_KEY=
TRIAL_AI_MODEL=
